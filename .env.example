# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# RevenueCat public SDK key — safe to include client-side (it's a public key)
# Get from: https://app.revenuecat.com → Project → API Keys
EXPO_PUBLIC_REVENUECAT_KEY=REPLACE_ME

# NOTE: The Anthropic API key is NO LONGER stored here.
# It is now stored securely in Firebase Secret Manager (server-side only).
# To set it, run:
#   firebase functions:secrets:set ANTHROPIC_API_KEY
# Then enter your key from https://console.anthropic.com
