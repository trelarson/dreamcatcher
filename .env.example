# Copy this file to .env and fill in your values.
# .env is gitignored — never commit real keys.

# Anthropic API key — get from console.anthropic.com
# WARNING: EXPO_PUBLIC_ prefix bundles this into the client app.
# Before production launch, move Claude calls to a Firebase Cloud Function
# and use a non-public env var there instead.
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-REPLACE_ME
